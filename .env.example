# =================================================================
# BloodLink AI - Environment Configuration Template
# Copy this file to .env and fill in your credentials
# =================================================================

# 1. Supabase PostgreSQL Database Credentials
SUPABASE_HOST=your-supabase-db-host.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-supabase-password

# 2. Server Ports & URLs
BACKEND_PORT=8080
ML_API_URL=http://localhost:8087
ML_SERVICE_BASE_URL=http://localhost:8087
ML_TOP_N_DONORS=5

# 3. Telegram Bot Integration (Optional for local testing)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_TEST_CHAT_ID=your-telegram-chat-id
